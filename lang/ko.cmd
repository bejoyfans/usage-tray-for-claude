rem Strings for the batch files, UTF-8
set "M_TITLE=Claude 사용량 위젯 - 설치"
set "M_HEAD= ==== Claude 사용량 위젯 원클릭 설치 ===="
set "M_PYOK=[1/4] Python 준비 완료"
set "M_PYINST=[1/4] Python을 찾을 수 없어 자동으로 설치합니다. 인터넷이 필요하며 1~2분 걸립니다..."
set "M_NOPY1=Python 자동 설치에 실패했습니다."
set "M_NOPY2=https://www.python.org/downloads/ 에서 다운로드하여 설치하세요."
set "M_NOPY3=설치할 때 Add python.exe to PATH를 선택한 뒤, 이 파일을 다시 더블클릭하세요."
