set "U_TITLE=Claude 사용량 위젯 - 제거"
set "U_HEAD= ==== Claude 사용량 위젯 제거 ===="
set "U_INFO1= 수행 작업: 프로그램 종료, Windows 시작 시 자동 실행 해제, 설치된 파일과 설정 삭제."
set "U_INFO2= Python은 제거되지 않으며 claude.ai 계정과 데이터에도 영향이 없습니다."
